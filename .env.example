# Copy to .env.local (gitignored) and fill in. Used ONLY by `npm run sync:music`
# on your machine — the deployed site never reads these.

# YouTube Data API v3 key. Create at Google Cloud Console → APIs & Services →
# Credentials → Create credentials → API key. Then under "API restrictions",
# restrict the key to the YouTube Data API v3 only.
YOUTUBE_API_KEY=

# The playlist to sync: the value after ?list= in the playlist's share URL.
# The playlist must be Public or Unlisted (YouTube does not allow the built-in
# "Liked Music" playlist to be shared — create a regular playlist instead).
YOUTUBE_PLAYLIST_ID=
